# Copy thành .env (KHÔNG commit .env)
PORT=3000
RPC_URL=http://127.0.0.1:7545
# Để trống: lấy địa chỉ từ shared/contract/deployment.json
CONTRACT_ADDRESS=
# true = các route GET trả dữ liệu trong shared/mock (khi chưa có contract)
MOCK_CHAIN=false
# Địa chỉ gắn vào mã QR. Để trống: tự dùng IP mạng LAN của máy + PORT
# (để điện thoại cùng Wi-Fi quét được). Ví dụ: http://192.168.1.10:3000
PUBLIC_URL=
