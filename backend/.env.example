# Copy thành .env (KHÔNG commit .env). Để trống = dùng shared/contract/deployment.json (Sepolia)
PORT=3000
# RPC của mạng. Mặc định: RPC công khai của Sepolia trong deployment.json
RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
# Khối deploy contract: backend chỉ đọc event từ khối này trở đi
DEPLOY_BLOCK=
# Số khối mỗi lần đọc event (RPC công khai giới hạn khoảng quét)
LOG_CHUNK_SIZE=5000
# true = các route GET chuỗi trả dữ liệu trong shared/mock (khi chưa có contract)
MOCK_CHAIN=false
# Địa chỉ gắn vào mã QR. Để trống: tự dùng IP mạng LAN của máy + PORT
# (để điện thoại cùng Wi-Fi quét được). Ví dụ: http://192.168.1.10:3000
PUBLIC_URL=

# Chạy thử trên Ganache local thay vì Sepolia:
# RPC_URL=http://127.0.0.1:7545
# CHAIN_ID=1337
# CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab
# DEPLOY_BLOCK=0
